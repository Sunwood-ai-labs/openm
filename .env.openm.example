# OpenM application
WEBUI_NAME=OpenM
WEBUI_SECRET_KEY=replace-with-a-long-random-secret
OPENM_AGENT_MODE=demo
OPENM_WORKSPACE_ROOT=/app/backend/data/openm-workspaces
OPENM_MAX_CONCURRENT_TASKS=2
OPENM_PERMISSION_TIMEOUT_SECONDS=600

# Switch OPENM_AGENT_MODE to live after configuring the gateway.
OPENM_LITELLM_BASE_URL=http://litellm:4000
OPENM_LITELLM_TOKEN=sk-openm-local
OPENM_DEFAULT_MODEL=claude-glm-code
OPENM_DEFAULT_MAIN_MODEL=claude-glm-main

# LiteLLM / Z.AI
LITELLM_MASTER_KEY=sk-openm-local
ZAI_API_KEY=replace-with-zai-api-key
